{
  "name": "dsh-claude-ultra",
  "version": "0.1.4",
  "description": "Claude-style Ultra mode for DSH: the top reasoning effort plus standing multi-agent orchestration",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AndyZh0/dsh-claude-ultra.git"
  },
  "homepage": "https://github.com/AndyZh0/dsh-claude-ultra#readme",
  "bugs": {
    "url": "https://github.com/AndyZh0/dsh-claude-ultra/issues"
  },
  "keywords": ["dsh","dsh-plugin","deepseek-harness","claude-code","ultracode","reasoning-effort","multi-agent"],
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "dsh-codex-effort-switcher"
      ]
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "pretest": "node scripts/build.mjs && node scripts/build-test.mjs",
    "test": "node --test \"tests/*.spec.mjs\"",
    "smoke": "node tests/browser-smoke.mjs",
    "prepack": "node scripts/build.mjs"
  },
  "dependencies": {
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "22.20.0",
    "esbuild": "0.25.12",
    "playwright": "^1.58.2",
    "typescript": "6.0.3"
  }
}
